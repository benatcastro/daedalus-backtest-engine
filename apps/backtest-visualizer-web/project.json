{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "backtest-visualizer-web",
  "projectType": "application",
  "sourceRoot": "apps/backtest-visualizer-web/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/.next"],
      "options": {
        "command": "next build",
        "cwd": "apps/backtest-visualizer-web"
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next dev --turbopack",
        "cwd": "apps/backtest-visualizer-web"
      }
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "command": "next start",
        "cwd": "apps/backtest-visualizer-web"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "apps/backtest-visualizer-web"
      }
    }
  },
  "tags": ["lang:ts", "scope:web"]
}
