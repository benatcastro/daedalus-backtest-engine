# =============================================================================
# data-downloader — environment file
# -----------------------------------------------------------------------------
# Copy to `.env` inside apps/data-downloader and adjust as needed.
# These variables are read from the process environment (see config.py).
# =============================================================================

# Destination root for downloaded market data, laid out in the QuantConnect Lean
# folder structure (<security_type>/<market>/<resolution>/<ticker>).
# Defaults to: $HOME/Workspace/algotrading/lean/data
LEAN_DATA_FOLDER=

# --- Exchange API keys (optional) --------------------------------------------
# Public OHLCV/candle endpoints used by ccxt do NOT require keys. Provide these
# only if you extend the downloader to use authenticated/private endpoints
# (account data, higher rate limits, order history, etc.).
# Get keys from your exchange's API management page (e.g. Binance > API Management).
BINANCE_API_KEY=
BINANCE_API_SECRET=
