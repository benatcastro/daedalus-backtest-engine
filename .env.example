# =============================================================================
# Daedalus monorepo — shared environment file
# -----------------------------------------------------------------------------
# Copy this file to `.env` in the repository root:  cp .env.example .env
# It is consumed by:
#   - apps/frontend            (Next.js, loaded via next.config.ts + dotenv-cli)
#   - apps/backtest-backend    (FastAPI, loaded via apps/backtest-backend/src/config.py)
#   - docker/docker-compose.yml (Postgres + pgAdmin)
# The .env file is gitignored — never commit real credentials.
# =============================================================================

# --- Application URLs --------------------------------------------------------
NEXT_PUBLIC_NEXT_API_URL=http://localhost:3000
NEXT_PUBLIC_BACKTEST_BACKEND_URL=http://localhost:8000
# Comma-separated list of origins allowed by the FastAPI CORS middleware
CORS_ORIGINS=http://localhost:3000

# --- Backtest database (FastAPI backend) -------------------------------------
BACKTEST_DATABASE_URL=postgresql://<BACKTEST_DB_USER>:<BACKTEST_DB_PASSWORD>@<BACKTEST_DB_HOST>:<BACKTEST_DB_PORT>/<BACKTEST_DB_NAME>

# --- Next.js / NextAuth database ---------------------------------------------
NEXT_DATABASE_URL=postgresql://<NEXTAUTH_DB_USER>:<NEXTAUTH_DB_PASSWORD>@<NEXTAUTH_DB_HOST>:<NEXTAUTH_DB_PORT>/<NEXTAUTH_DB_NAME>

# --- NextAuth (authentication) -----------------------------------------------
# Secret used to encrypt sessions/JWTs. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=<GENERATE_A_RANDOM_SECRET>
NEXTAUTH_URL=http://localhost:3000

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
# Create an "OAuth 2.0 Client ID" (Web application) and add the redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>

# --- Lean engine (FastAPI backend) -------------------------------------------
# Absolute path to your local QuantConnect Lean data directory (optional).
# LEAN_BASE_DATA_PATH=/path/to/lean/data

# --- Docker: Backtests database ----------------------------------------------
BACKTEST_DB_HOST=localhost
BACKTEST_DB_PORT=5432
BACKTEST_DB_NAME=backtests_db
BACKTEST_DB_USER=postgres
BACKTEST_DB_PASSWORD=<CHANGE_ME>

# --- Docker: NextAuth database -----------------------------------------------
NEXTAUTH_DB_HOST=localhost
NEXTAUTH_DB_PORT=5433
NEXTAUTH_DB_NAME=nextjs_db
NEXTAUTH_DB_USER=postgres
NEXTAUTH_DB_PASSWORD=<CHANGE_ME>

# --- Docker: pgAdmin ---------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@daedalus.local
PGADMIN_DEFAULT_PASSWORD=<CHANGE_ME>

# =============================================================================
# Security notes:
#   - Change ALL passwords and secrets before deploying anywhere non-local.
#   - Use environment-specific values for dev / staging / prod.
#   - Prefer a secrets manager in production.
#   - Never commit the real .env file to version control.
# =============================================================================
