# Application URLs
NEXTJS_URL=<NEXTJS_URL>
FASTAPI_URL=<FASTAPI_URL>
CORS_ORIGINS=<CORS_ORIGINS>

# Database Configuration - PostgreSQL
# Main database for backtest data (used by FastAPI backend)
DATABASE_URL=postgresql://<BACKTEST_DB_USER>:<BACKTEST_DB_PASSWORD>@<BACKTEST_DB_HOST>:<BACKTEST_DB_PORT>/<BACKTEST_DB_NAME>
BACKTEST_DATABASE_URL=postgresql://<BACKTEST_DB_USER>:<BACKTEST_DB_PASSWORD>@<BACKTEST_DB_HOST>:<BACKTEST_DB_PORT>/<BACKTEST_DB_NAME>

# Next.js application database (user management, auth, etc.)
NEXT_DATABASE_URL=postgresql://<NEXTAUTH_DB_USER>:<NEXTAUTH_DB_PASSWORD>@<NEXTAUTH_DB_HOST>:<NEXTAUTH_DB_PORT>/<NEXTAUTH_DB_NAME>

# NextAuth.js Configuration
NEXTAUTH_SECRET=<YOUR_NEXTAUTH_SECRET_KEY>
NEXTAUTH_URL=<NEXTAUTH_URL>

# FastAPI Configuration
FASTAPI_SECRET_KEY=<YOUR_FASTAPI_SECRET_KEY>
FASTAPI_DEBUG=<true|false>
FASTAPI_RELOAD=<true|false>

# Docker Database Configuration (for docker-compose)
# Backtests Database
BACKTEST_DB_HOST=<BACKTEST_DB_HOST>
BACKTEST_DB_PORT=<BACKTEST_DB_PORT>
BACKTEST_DB_NAME=<BACKTEST_DB_NAME>
BACKTEST_DB_USER=<BACKTEST_DB_USER>
BACKTEST_DB_PASSWORD=<BACKTEST_DB_PASSWORD>

# NextAuth Database
NEXTAUTH_DB_HOST=<NEXTAUTH_DB_HOST>
NEXTAUTH_DB_PORT=<NEXTAUTH_DB_PORT>
NEXTAUTH_DB_NAME=<NEXTAUTH_DB_NAME>
NEXTAUTH_DB_USER=<NEXTAUTH_DB_USER>
NEXTAUTH_DB_PASSWORD=<NEXTAUTH_DB_PASSWORD>

# pgAdmin Configuration
PGADMIN_DEFAULT_EMAIL=<PGADMIN_DEFAULT_EMAIL>
PGADMIN_DEFAULT_PASSWORD=<PGADMIN_DEFAULT_PASSWORD>

# File Upload Configuration
MAX_UPLOAD_SIZE=<MAX_UPLOAD_SIZE>
UPLOAD_DIR=<UPLOAD_DIR>

# Logging
LOG_LEVEL=<LOG_LEVEL>

# Frontend-specific Configuration
NEXT_PUBLIC_API_BASE_URL=<NEXT_PUBLIC_API_BASE_URL>
BACKTEST_API_URL=<BACKTEST_API_URL>

# Google OAuth Configuration (for NextAuth)
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>

# Security Notes:
# - Change ALL passwords and secrets before deploying to production
# - Use environment-specific values for different stages (dev/staging/prod)
# - Consider using a secrets management service in production
# - Never commit the actual .env file to version control
